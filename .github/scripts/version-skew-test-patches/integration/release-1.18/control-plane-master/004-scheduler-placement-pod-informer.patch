+package kubernetes
+
+import (
+	"testing"
+
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+)
+
+// WithSkewNamespacedPodList serves an empty pod list on the namespaced pod
+// path that newer schedulers and operators list and watch, so the path does
+// not return 404. It does not satisfy the operator's GetConfiguration pod
+// check; a later option serving app pods on the same path overrides it.
+func WithSkewNamespacedPodList(t *testing.T, ns string) Option {
+	return handleClusterListResource(t, "/api/v1/namespaces/"+ns+"/pods",
+		&corev1.PodList{TypeMeta: metav1.TypeMeta{APIVersion: "v1", Kind: "PodList"}})
+}
